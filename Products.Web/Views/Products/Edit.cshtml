@model Products.Web.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Редактирование продукта";
}

<h1>Редактирование продукта</h1>

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Чтобы добавить продукт, нужна хотя бы одна категория.
    </div>
}

<form asp-action="Edit"
      asp-route-id="@ViewContext.RouteData.Values["id"]"
      method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="text" inputmode="decimal" class="form-control" data-val-number="Введите число с запятой, например 95,50." />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" step="1" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId"
                asp-items="Model.Categories"
                class="form-select">
            <option value="">Выберите категорию</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary"
            disabled="@(Model.Categories.Count == 0)">
        Сохранить
    </button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/price-validation.js" asp-append-version="true"></script>
}