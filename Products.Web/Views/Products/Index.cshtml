@model IReadOnlyList<Products.Web.Models.Product>

@{
    ViewData["Title"] = "Продукты";
}

<h1>Продукты</h1>

@if (Model.Count == 0)
{
    <p>Продуктов пока нет.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Категория</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("0.00")</td>
                <td>@product.Quantity</td>
                <td>@product.Category.Name</td>
            </tr>
        }
        </tbody>
    </table>
}