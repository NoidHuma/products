@model IReadOnlyList<Products.Web.Models.Product>

@{
    ViewData["Title"] = "Продукты";
}

<h1>Продукты</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить продукт</a>
</p>

@if (Model.Count == 0)
{
    <p>Продуктов пока нет.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Категория</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("0.00")</td>
                <td>@product.Quantity</td>
                <td>@product.Category.Name</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@product.Id"
                       class="btn btn-outline-secondary btn-sm">
                        Подробнее
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="btn btn-outline-primary btn-sm">
                        Редактировать
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}