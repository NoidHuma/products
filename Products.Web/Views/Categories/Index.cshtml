@model IReadOnlyList<Products.Web.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<h1>Категории продуктов</h1>

@if (Model.Count == 0)
{
    <p>Категорий пока нет.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
            </tr>
        }
        </tbody>
    </table>
}